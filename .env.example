# Vorlage: kopieren nach .env und Werte eintragen. Die .env wird nie committet.

# Datenbank (lokal: Docker Compose; Produktion: Neon, direkter Host ohne -pooler)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=korbgeld
DB_USER=korbgeld
DB_PASSWORD=
# lokal disable, Neon require
DB_SSLMODE=disable

# Ab Phase 2: zufällig, mindestens 32 Zeichen
JWT_SECRET=

# Adresse des Frontends (für CORS)
FRONTEND_URL=http://localhost:5173

# Optional, ab M4 (Team): Kursdaten von Twelve Data
TWELVEDATA_API_KEY=

# Adresse des Backends aus Sicht des Browsers
VITE_API_BASE_URL=http://localhost:8080
